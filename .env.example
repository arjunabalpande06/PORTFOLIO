# ==============================================================================
# ARJUN BALPANDE PORTFOLIO & ADMIN ANALYTICS — ENVIRONMENT CONFIGURATION
# Copy this file to .env for local development.
# On Vercel: Add these variables under Project Settings > Environment Variables.
# ==============================================================================

# Admin Dashboard Access Password (Required)
# Use a strong password. You can provide the plaintext password here:
ADMIN_PASSWORD=ArjunAdmin2026!Secure

# Alternatively, you can use a precomputed bcrypt hash:
# ADMIN_PASSWORD_HASH=$2a$10$...

# Secret key for signing HTTP-only session cookies & JWT (Required)
JWT_SECRET=super_secret_jwt_random_key_change_in_production_987456321

# Salt for privacy-preserving visitor SHA-256 hashing (Optional, defaults to internal salt)
ANALYTICS_SALT=portfolio_privacy_salt_arjun_balpande_2026

# PostgreSQL Database Connection String (Recommended for production on Vercel)
# Can be from Neon (https://neon.tech), Supabase (https://supabase.com), or Vercel Postgres.
# Example: postgres://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Cookie security settings (set to true on production HTTPS, false on local localhost)
COOKIE_SECURE=false

# Port for local development server
PORT=3000
